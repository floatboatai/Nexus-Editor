{
  "name": "@floatboat/nexus-reference-plugins",
  "version": "0.0.14",
  "description": "Migration fixtures and host wiring helpers for the Nexus plugin platform.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures/obsidian-sample-plugin/LICENSE",
    "fixtures/obsidian-sample-plugin/SOURCE.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform browser --dts --clean",
    "check:api": "pnpm build && tsc --noEmit -p tsconfig.api.json && node scripts/check-api.mjs",
    "check:api:update": "pnpm build && node scripts/check-api.mjs --write",
    "test": "vitest run --config vitest.config.ts test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floatboat/nexus-core": "workspace:*",
    "@floatboat/nexus-plugin-api": "workspace:*",
    "@floatboat/nexus-plugin-history": "workspace:*",
    "@floatboat/nexus-plugin-math": "workspace:*",
    "@floatboat/nexus-plugin-runtime": "workspace:*",
    "@floatboat/nexus-plugin-search": "workspace:*",
    "@floatboat/nexus-plugin-slash": "workspace:*",
    "@floatboat/nexus-plugin-toolbar": "workspace:*",
    "@floatboat/nexus-plugin-vim": "workspace:*",
    "@floatboat/nexus-plugin-wordcount": "workspace:*",
    "@floatboat/nexus-preset-gfm": "workspace:*",
    "@floatboat/nexus-plugin-formatting": "workspace:*",
    "@floatboat/nexus-plugin-selection-toolbar": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/view": "^6.36.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
