{
  "name": "@floatboat/nexus-plugin-block-drag",
  "version": "0.0.14",
  "description": "Single-block Markdown drag reordering for Nexus-Editor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
