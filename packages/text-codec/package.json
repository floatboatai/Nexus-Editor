{
  "name": "@floatboat/nexus-text-codec",
  "version": "0.0.14",
  "description": "Explicit, loss-checked document text encoding without file-system access.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./legacy": { "types": "./dist/legacy.d.ts", "import": "./dist/legacy.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check:api": "pnpm build && tsc --noEmit -p tsconfig.api.json && node --experimental-vm-modules scripts/check-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "iconv-lite": "^0.7.3"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
