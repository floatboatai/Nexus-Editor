{
  "name": "@floatboat/nexus-document",
  "version": "0.0.14",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./gfm": {
      "types": "./dist/gfm.d.ts",
      "import": "./dist/gfm.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js"
    },
    "./docx": {
      "types": "./dist/docx.d.ts",
      "import": "./dist/docx.js"
    },
    "./pdf-text": {
      "types": "./dist/pdf-text.d.ts",
      "import": "./dist/pdf-text.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./export-html": {
      "types": "./dist/export-html.d.ts",
      "import": "./dist/export-html.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./node-worker": {
      "types": "./dist/node-worker.d.ts",
      "import": "./dist/node-worker.js"
    },
    "./browser-worker": {
      "types": "./dist/browser-worker.d.ts",
      "import": "./dist/browser-worker.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./worker-browser": {
      "import": "./dist/worker-browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/build-browser-worker.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@floatboat/nexus-core": "workspace:*",
    "csv-parse": "7.0.2",
    "dompurify": "3.4.15",
    "fflate": "0.8.3",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "peerDependencies": {
    "@floatboat/nexus-plugin-runtime": "workspace:*",
    "katex": "^0.16.45",
    "mammoth": "1.12.2",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.3.289",
    "remark-math": "6.0.0"
  },
  "peerDependenciesMeta": {
    "@floatboat/nexus-plugin-runtime": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    }
  },
  "devDependencies": {
    "decode-named-character-reference": "1.3.0",
    "@floatboat/nexus-plugin-runtime": "workspace:*",
    "@types/katex": "^0.16.7",
    "katex": "0.16.45",
    "mammoth": "1.12.2",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.3.289",
    "remark-math": "6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
