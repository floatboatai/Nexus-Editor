{
  "name": "@floatboat/nexus-plugin-runtime",
  "version": "0.0.14",
  "description": "Host-neutral lifecycle and registry runtime for Nexus plugins.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform browser --dts --clean",
    "check:api": "pnpm build && tsc --noEmit -p tsconfig.api.json && node scripts/check-api.mjs",
    "check:api:update": "pnpm build && node scripts/check-api.mjs --write",
    "test": "vitest run --config vitest.config.ts test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floatboat/nexus-core": "workspace:*",
    "@floatboat/nexus-plugin-api": "workspace:*",
    "@types/mdast": "^4.0.4",
    "js-yaml": "^4.3.1",
    "semver": "^7.7.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@types/js-yaml": "^4.0.9",
    "@types/semver": "^7.7.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
