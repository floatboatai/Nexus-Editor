# The CLI does not automatically load this file. Export variables, use Node --env-file,
# or use deploy/nexus-collab.service with its separate protected signing credential.
# Required. Generate once per deployment, retain across restarts; never commit it.
NEXUS_COLLAB_AUTH_SECRET=
NEXUS_COLLAB_STORAGE_DIR=/var/lib/nexus-collab
NEXUS_COLLAB_ADDRESS=127.0.0.1
NEXUS_COLLAB_PORT=1234
NEXUS_COLLAB_MAX_DOCUMENT_BYTES=8388608
NEXUS_COLLAB_MAX_AUTHENTICATED_QUEUE_BYTES=2097152
NEXUS_COLLAB_MAX_AUTHENTICATED_QUEUE_MESSAGES=8
NEXUS_COLLAB_INVITATION_MAX_TTL=900
# Explicit empty is important behind a public reverse proxy, even on loopback.
# Electron Main makes invitation requests without Origin. Never expose null publicly.
NEXUS_COLLAB_INVITATION_ORIGINS=
