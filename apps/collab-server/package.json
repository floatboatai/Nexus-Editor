{
  "name": "@floatboat/nexus-collab-server",
  "version": "0.0.14",
  "private": true,
  "description": "Authenticated, durable Hocuspocus reference server for Nexus collaboration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --platform node --dts --clean",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run --config vitest.config.ts",
    "test:deployment": "node --test deploy/run-with-credentials.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floatboat/nexus-plugin-collab": "workspace:*",
    "@hocuspocus/server": "4.6.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@floatboat/nexus-core": "workspace:*",
    "tsx": "4.20.6",
    "tsup": "^8.5.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
